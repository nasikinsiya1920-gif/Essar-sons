<%- include('partials/head', { title: title, description: description }) %>
<%- include('partials/nav') %>
<%- include('partials/breadcrumb', { crumb: project.title }) %>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://essarsons.com/" },
    { "@type": "ListItem", "position": 2, "name": "Projects", "item": "https://essarsons.com/projects" },
    { "@type": "ListItem", "position": 3, "name": "<%- project.title.replace(/"/g, '\\"') %>", "item": "https://essarsons.com<%= currentPath %>" }
  ]
}
</script>

<%
  var heroMedia = project.bannerImage || project.img;
  var divisionMatch = divisions.find(function(d) { return d.key === project.divisions[0]; });
  var divisionLabel = project.division || (divisionMatch && divisionMatch.name);
  var divisionHref = project.divisionSlug ? '/business/' + project.divisionSlug : (divisionMatch && divisionMatch.href);

  var facts = [];
  if (project.client) facts.push(['Client', project.client]);
  if (project.location) facts.push(['Location', project.location]);
  if (project.year) facts.push(['Year', project.year]);
  if (project.stationsCovered) facts.push(['Stations Covered', project.stationsCovered]);
%>

<main>
  <section class="hero hero-firm band-dark" style="background-image: linear-gradient(180deg, rgba(14,42,59,0.55) 0%, rgba(14,42,59,0.88) 100%), url('<%= heroMedia %>')">
    <div class="container hero-content">
      <% if (divisionLabel) { %><span class="eyebrow eyebrow-light"><%= divisionLabel %></span><% } %>
      <h1 class="hero-h1 hero-h1-page" data-word-reveal><%= project.title %></h1>
      <p class="hero-lead"><%= project.outcome || project.desc %></p>
    </div>
  </section>

  <% if (facts.length) { %>
    <section class="section" data-reveal>
      <div class="container">
        <%- include('partials/stat-grid', { stats: facts, cols: facts.length }) %>
      </div>
    </section>
  <% } %>

  <% if (project.scope) { %>
    <section class="section band-gray" data-reveal>
      <div class="container article-body">
        <span class="eyebrow">Scope of Work</span>
        <p class="lead"><%= project.scope %></p>
      </div>
    </section>
  <% } %>

  <% if (project.challenge) { %>
    <section class="section" data-reveal>
      <div class="container article-body">
        <span class="eyebrow">The Challenge</span>
        <h2 class="h2" style="font-size: clamp(22px, 2.4vw, 32px);">What made this job hard.</h2>
        <p><%= project.challenge %></p>
      </div>
    </section>
  <% } %>

  <% if (project.approach && project.approach.length) { %>
    <section class="section band-gray" data-reveal>
      <div class="container article-body">
        <span class="eyebrow">Our Approach</span>
        <h2 class="h2" style="font-size: clamp(22px, 2.4vw, 32px);">How we delivered it.</h2>
        <ul class="article-list">
          <% project.approach.forEach(function(step) { %>
            <li><%= step %></li>
          <% }); %>
        </ul>
      </div>
    </section>
  <% } %>

  <% if (project.differentiator) { %>
    <section class="section" data-reveal>
      <div class="container article-body">
        <span class="eyebrow">What Set This Apart</span>
        <p class="lead"><%= project.differentiator %></p>
      </div>
    </section>
  <% } %>

  <%
    var galleryImages = (project.gallery && project.gallery.length) ? project.gallery : (project.img ? [{ src: project.img, alt: project.title }] : []);
  %>
  <% if (galleryImages.length) { %>
    <section class="section band-gray" data-reveal>
      <div class="container">
        <span class="eyebrow">Gallery</span>
        <h2 class="h2" style="font-size: clamp(22px, 2.4vw, 32px); margin-bottom: 24px;">On site.</h2>
        <div class="project-gallery-grid project-gallery-grid-<%= galleryImages.length === 1 ? 'single' : 'multi' %>">
          <% galleryImages.forEach(function(g) { %>
            <div class="project-gallery-item">
              <img src="<%= g.src %>" alt="<%= g.alt || project.title %>" loading="lazy">
            </div>
          <% }); %>
        </div>
      </div>
    </section>
  <% } else if (project.video) { %>
    <section class="section band-gray" data-reveal>
      <div class="container">
        <div class="strip-image">
          <video controls style="width: 100%; display: block;">
            <source src="<%= project.video %>" type="video/mp4">
          </video>
        </div>
      </div>
    </section>
  <% } %>

  <% if (divisionLabel && divisionHref) { %>
    <section class="section band-dark text-center" data-reveal>
      <div class="container">
        <span class="eyebrow eyebrow-light">Where This Fits</span>
        <h2 class="h2">Delivered by our <%= divisionLabel %> division.</h2>
        <a href="<%= divisionHref %>" class="btn btn-primary">Visit <%= divisionLabel %> &rarr;</a>
      </div>
    </section>
  <% } %>

  <section class="section text-center" data-reveal>
    <div class="container">
      <a href="/projects" class="text-link">&larr; Back to All Projects</a>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
<%- include('partials/scripts') %>
