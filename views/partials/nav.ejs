<header class="site-nav" id="siteNav">
  <div class="container nav-inner">
    <a href="/" class="nav-logo"><img src="/img/logo-side.svg" alt="Essar Sons"></a>
    <div class="nav-right">
      <nav class="nav-links" id="navLinks" aria-label="Primary">
        <a href="/about" class="<%= currentPath === '/about' ? 'active' : '' %>">About Us</a>
        <a href="/businesses" class="<%= currentPath === '/businesses' ? 'active' : '' %>">Our Businesses</a>
        <a href="/projects" class="<%= currentPath === '/projects' ? 'active' : '' %>">Projects</a>
        <a href="/blog" class="<%= currentPath.startsWith('/blog') ? 'active' : '' %>">Blog</a>
