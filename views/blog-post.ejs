<%- include('partials/head', { title: title, description: description }) %>
<%- include('partials/nav') %>
<%- include('partials/breadcrumb', { crumb: post.title }) %>

<main>
  <section class="section article-section" data-reveal>
    <div class="container article-body">
      <span class="eyebrow">Essar Sons Group Blog</span>
      <h1 class="hero-h1 hero-h1-page"><%= post.title %></h1>
      <%- include('partials/article-blocks', { blocks: post.content.slice(0, 1) }) %>
    </div>
  </section>

  <%- include('partials/cta-band', { cta: post.cta, showText: false }) %>

  <section class="section article-section" data-reveal>
    <div class="container article-body">
      <%- include('partials/article-blocks', { blocks: post.content.slice(1) }) %>
    </div>
  </section>

  <%- include('partials/cta-band', { cta: post.cta, showText: true }) %>

  <section class="section article-section" data-reveal>
    <div class="container article-body">
      <a href="/blog" class="text-link">&larr; Back to Blog</a>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
<%- include('partials/smart-tab') %>
<%- include('partials/scripts') %>
